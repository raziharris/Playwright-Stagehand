{
  "name": "cityfm-playwright",
  "version": "1.0.0",
  "description": "AI-assisted QA automation workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "playwright test",
    "qa:sync": "tsx server/sync.ts",
    "qa:deploy": "npm run qa:sync"
  },
  "devDependencies": {
    "@browserbasehq/stagehand": "^4.1.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "zod": "~4.4.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
